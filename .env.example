# Copy to .env and fill in. .env is gitignored.

# --- basics -----------------------------------------------------------------
PORT=3000
# Your timezone, so the morning brief and the Sunday plan run at the right hour.
TZ=America/New_York
# Set to production on a real host: session cookies then require HTTPS.
# NODE_ENV=production
# The public address of the app. Needed for the Google Calendar redirect.
# PUBLIC_URL=https://your-app.example.com

# --- accounts ---------------------------------------------------------------
# The first person to open the app creates the account; after that signup is
# closed. Set this to true if you want to allow more accounts.
# SIGNUP_OPEN=true
# Optional key for scripts and uptime checks; it acts as the first account.
# API_TOKEN=a-long-random-string

# --- storage ----------------------------------------------------------------
# SQLite file (used when DATABASE_URL is empty). Point it at a mounted disk.
DB_FILE=data/amer.db
# Hosted Postgres instead, for hosts with no disk (Neon, Supabase, Render...).
# DATABASE_URL=postgres://user:password@host/dbname

# --- Ask Claude and the written briefs --------------------------------------
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- notifications (run: npm run keys:push) ---------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Google Calendar --------------------------------------------------------
# console.cloud.google.com -> enable the Calendar API -> OAuth client (Web)
# Redirect URI: <PUBLIC_URL>/api/gcal/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Set to off to skip the scheduled jobs (useful when running a second copy).
# JOBS=off
